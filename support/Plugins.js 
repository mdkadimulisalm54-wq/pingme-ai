
/* =========================================================
   PingMe AI — Plugins Manager & UI
   ========================================================= */

(() => {
    "use strict";

    const KEY = "pingme_plugins_v1";
    const registry = new Map();
    let panel = null;

    const builtIns = [
        {
            id: "web-search",
            name: "Web Search",
            description: "Search the web for useful information.",
            category: "Research"
        },
        {
            id: "gmail",
            name: "Gmail",
            description: "Connect and manage your emails.",
            category: "Productivity"
        },
        {
            id: "google-drive",
            name: "Google Drive",
            description: "Access files from Google Drive.",
            category: "Productivity"
        }
    ];

    function read() {
        try {
            return JSON.parse(localStorage.getItem(KEY) || "{}");
        } catch {
            return {};
        }
    }

    function save(data) {
        localStorage.setItem(KEY, JSON.stringify(data));
        window.dispatchEvent(new CustomEvent("pingme:plugins-changed", {
            detail: { plugins: list() }
        }));
    }

    function register(plugin) {
        if (!plugin?.id || !/^[a-z0-9-]+$/.test(plugin.id)) {
            throw new Error("Invalid plugin ID.");
        }

        registry.set(plugin.id, {
            ...plugin,
            status: plugin.status || "not-connected",
            execute: typeof plugin.execute === "function"
                ? plugin.execute
                : null
        });

        return get(plugin.id);
    }

    function get(id) {
        const p = registry.get(id);
        if (!p) return null;

        return {
            id: p.id,
            name: p.name,
            description: p.description || "",
            category: p.category || "Other",
            status: p.status,
            enabled: read()[id]?.enabled === true,
            connected: p.status === "connected",
            available: Boolean(p.execute)
        };
    }

    function list() {
        return [...registry.keys()].map(get);
    }

    function setEnabled(id, enabled) {
        if (!registry.has(id)) throw new Error("Plugin not found.");

        const data = read();
        data[id] = { ...(data[id] || {}), enabled: Boolean(enabled) };
        save(data);
        render();
        return get(id);
    }

    function isEnabled(id) {
        return get(id)?.enabled === true;
    }

    async function execute(id, input, context = {}) {
        const p = registry.get(id);

        if (!p) throw new Error("Plugin not found.");
        if (!isEnabled(id)) throw new Error("Enable this plugin first.");
        if (p.status !== "connected" || !p.execute) {
            throw new Error(p.name + " is not connected yet.");
        }

        return p.execute(input, context);
    }

    function addStyles() {
        if (document.getElementById("pingme-plugins-style")) return;

        const style = document.createElement("style");
        style.id = "pingme-plugins-style";
        style.textContent = `
            #pingmePluginsPanel {
                position: fixed;
                inset: 0;
                z-index: 99990;
                background: var(--bg, var(--background, #fff));
                color: var(--text, var(--text-color, #171717));
                overflow-y: auto;
                padding: 20px;
                box-sizing: border-box;
                font-family: inherit;
            }
            #pingmePluginsPanel * { box-sizing: border-box; }
            .pm-plugins-head {
                display:flex; align-items:center; gap:14px;
                margin:0 auto 24px; max-width:760px;
            }
            .pm-plugins-head h2 { margin:0; font-size:22px; }
            .pm-plugins-back {
                width:42px; height:42px; border:1px solid #8884;
                border-radius:50%; background:transparent;
                color:inherit; font-size:23px; cursor:pointer;
            }
            .pm-plugins-content { max-width:760px; margin:auto; }
            .pm-plugins-intro { margin:0 0 22px; color:inherit; opacity:.7; }
            .pm-plugin-card {
                display:flex; align-items:center; gap:14px;
                padding:16px; margin:12px 0;
                border:1px solid #8884; border-radius:16px;
            }
            .pm-plugin-icon {
                width:44px; height:44px; flex:0 0 44px;
                display:grid; place-items:center; border-radius:13px;
                background:#8882; font-size:21px;
            }
            .pm-plugin-info { flex:1; min-width:0; }
            .pm-plugin-info h3 { margin:0 0 5px; font-size:16px; }
            .pm-plugin-info p { margin:0; opacity:.7; font-size:13px; line-height:1.45; }
            .pm-plugin-status { margin-top:7px; font-size:12px; opacity:.7; }
            .pm-plugin-toggle {
                width:44px; height:26px; flex:0 0 44px;
                appearance:none; border-radius:20px;
                background:#8886; position:relative; cursor:pointer;
                transition:background .2s;
            }
            .pm-plugin-toggle:before {
                content:""; position:absolute; top:3px; left:3px;
                width:20px; height:20px; border-radius:50%;
                background:white; transition:transform .2s;
            }
            .pm-plugin-toggle:checked { background:#1684f8; }
            .pm-plugin-toggle:checked:before { transform:translateX(18px); }
            .pm-plugin-note { font-size:12px; opacity:.65; margin-top:20px; }
        `;
        document.head.appendChild(style);
    }

    function ensurePanel() {
        if (panel?.isConnected) return panel;

        panel = document.createElement("section");
        panel.id = "pingmePluginsPanel";
        panel.hidden = true;
        panel.innerHTML = `
            <header class="pm-plugins-head">
                <button class="pm-plugins-back" type="button"
                    aria-label="Back">‹</button>
                <h2>Plugins</h2>
            </header>
            <main class="pm-plugins-content">
                <p class="pm-plugins-intro">
                    Use connected tools with PingMe AI.
                </p>
                <div class="pm-plugins-list"></div>
                <p class="pm-plugin-note">
                    Enabling a plugin does not connect an account.
                    Integrations require their own secure connection.
                </p>
            </main>
        `;

        panel.querySelector(".pm-plugins-back").addEventListener("click", close);
        document.body.appendChild(panel);
        return panel;
    }

    function render() {
        if (!panel?.isConnected) return;

        const host = panel.querySelector(".pm-plugins-list");
        host.replaceChildren();

        const icons = {
            "web-search": "⌕",
            "gmail": "✉",
            "google-drive": "▣"
        };

        list().forEach(plugin => {
            const card = document.createElement("article");
            card.className = "pm-plugin-card";

            const icon = document.createElement("div");
            icon.className = "pm-plugin-icon";
            icon.textContent = icons[plugin.id] || "◇";

            const info = document.createElement("div");
            info.className = "pm-plugin-info";

            const name = document.createElement("h3");
            name.textContent = plugin.name;

            const description = document.createElement("p");
            description.textContent = plugin.description;

            const status = document.createElement("div");
            status.className = "pm-plugin-status";
            status.textContent = plugin.connected
                ? "Connected"
                : "Not connected";

            info.append(name, description, status);

            const toggle = document.createElement("input");
            toggle.type = "checkbox";
            toggle.className = "pm-plugin-toggle";
            toggle.checked = plugin.enabled;
            toggle.setAttribute("aria-label", "Enable " + plugin.name);
            toggle.addEventListener("change", () => {
                setEnabled(plugin.id, toggle.checked);
            });

            card.append(icon, info, toggle);
            host.appendChild(card);
        });
    }

    function open() {
        addStyles();
        ensurePanel();

        window.dispatchEvent(new CustomEvent("pingme:plugins-open", {
            detail: { plugins: list() }
        }));

        panel.hidden = false;
        document.body.style.overflow = "hidden";
        render();
    }

    function close() {
        if (panel) panel.hidden = true;
        document.body.style.overflow = "";
        window.dispatchEvent(new CustomEvent("pingme:plugins-close"));
    }

    builtIns.forEach(register);

    window.PingMePlugins = {
        register,
        get,
        list,
        setEnabled,
        isEnabled,
        execute,
        open,
        close
    };

    window.addEventListener("pingme:plus-plugins", open);

    window.dispatchEvent(new CustomEvent("pingme:plugins-ready"));
    console.log("PingMe Plugins: Ready");
})();
