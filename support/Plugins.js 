
/* =========================================================
   PingMe AI — Complete Plugins Page
   Manager • Enable/Disable • Open/Back • Mobile UI
   ========================================================= */

(() => {
    "use strict";

    const KEY = "pingme_plugins_v1";
    const STYLE_ID = "pm-plugins-style";
    const PAGE_ID = "pm-plugins-page";
    const registry = new Map();

    let page = null;
    let previousOverflow = "";

    const builtIns = [
        {
            id: "web-search",
            name: "Web Search",
            description: "Search the web for useful information.",
            category: "Research",
            icon: "⌕"
        },
        {
            id: "gmail",
            name: "Gmail",
            description: "Connect Gmail to manage your emails.",
            category: "Productivity",
            icon: "✉"
        },
        {
            id: "google-drive",
            name: "Google Drive",
            description: "Access files from Google Drive.",
            category: "Productivity",
            icon: "▣"
        }
    ];

    function readSettings() {
        try {
            return JSON.parse(localStorage.getItem(KEY) || "{}");
        } catch {
            return {};
        }
    }

    function saveSettings(data) {
        localStorage.setItem(KEY, JSON.stringify(data));

        window.dispatchEvent(new CustomEvent("pingme:plugins-changed", {
            detail: { plugins: list() }
        }));
    }

    function register(plugin) {
        if (!plugin || !/^[a-z0-9-]+$/.test(plugin.id || "")) {
            throw new Error("A valid plugin ID is required.");
        }

        registry.set(plugin.id, {
            ...plugin,
            status: plugin.status || "not-connected",
            execute: typeof plugin.execute === "function"
                ? plugin.execute
                : null
        });

        return get(plugin.id);
    }

    function get(id) {
        const plugin = registry.get(id);
        if (!plugin) return null;

        const settings = readSettings();

        return {
            id: plugin.id,
            name: plugin.name || plugin.id,
            description: plugin.description || "",
            category: plugin.category || "Other",
            status: plugin.status,
            enabled: settings[id]?.enabled === true,
            connected: plugin.status === "connected",
            available: Boolean(plugin.execute)
        };
    }

    function list() {
        return [...registry.keys()].map(get);
    }

    function setEnabled(id, enabled) {
        if (!registry.has(id)) {
            throw new Error("Plugin not found: " + id);
        }

        const data = readSettings();
        data[id] = {
            ...(data[id] || {}),
            enabled: Boolean(enabled)
        };

        saveSettings(data);
        render();
        return get(id);
    }

    function isEnabled(id) {
        return get(id)?.enabled === true;
    }

    async function execute(id, input, context = {}) {
        const plugin = registry.get(id);

        if (!plugin) throw new Error("Plugin not found: " + id);
        if (!isEnabled(id)) throw new Error("Enable this plugin first.");

        if (plugin.status !== "connected" || !plugin.execute) {
            throw new Error(plugin.name + " is not connected yet.");
        }

        return plugin.execute(input, context);
    }

    function addStyles() {
        if (document.getElementById(STYLE_ID)) return;

        const style = document.createElement("style");
        style.id = STYLE_ID;

        style.textContent = `
            #${PAGE_ID} {
                position: fixed;
                inset: 0;
                z-index: 2147483000;
                display: block;
                overflow-y: auto;
                overscroll-behavior: contain;
                background: var(--bg, var(--background, #fff));
                color: var(--text, var(--text-color, #171717));
                font-family: inherit;
                -webkit-overflow-scrolling: touch;
            }

            #${PAGE_ID}[hidden] { display: none !important; }

            #${PAGE_ID} * { box-sizing: border-box; }

            #${PAGE_ID} .pm-head {
                position: sticky;
                top: 0;
                z-index: 2;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 14px 18px;
                background: var(--bg, var(--background, #fff));
                border-bottom: 1px solid #8882;
            }

            #${PAGE_ID} .pm-back {
                width: 42px;
                height: 42px;
                border: 1px solid #8884;
                border-radius: 50%;
                background: transparent;
                color: inherit;
                font-size: 27px;
                cursor: pointer;
            }

            #${PAGE_ID} .pm-head h2 {
                margin: 0;
                font-size: 21px;
                font-weight: 650;
            }

            #${PAGE_ID} .pm-content {
                width: 100%;
                max-width: 720px;
                margin: 0 auto;
                padding: 22px 18px 36px;
            }

            #${PAGE_ID} .pm-intro {
                margin: 0 0 22px;
                font-size: 14px;
                line-height: 1.6;
                opacity: .7;
            }

            #${PAGE_ID} .pm-card {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 15px 13px;
                margin-bottom: 12px;
                border: 1px solid #8883;
                border-radius: 17px;
            }

            #${PAGE_ID} .pm-icon {
                display: grid;
                place-items: center;
                width: 44px;
                height: 44px;
                flex: 0 0 44px;
                border-radius: 13px;
                background: #8882;
                font-size: 23px;
            }

            #${PAGE_ID} .pm-info {
                flex: 1;
                min-width: 0;
            }

            #${PAGE_ID} .pm-info h3 {
                margin: 0 0 5px;
                font-size: 15px;
                font-weight: 650;
            }

            #${PAGE_ID} .pm-info p {
                margin: 0;
                font-size: 12px;
                line-height: 1.5;
                opacity: .7;
            }

            #${PAGE_ID} .pm-status {
                margin-top: 7px;
                font-size: 11px;
                opacity: .75;
            }

            #${PAGE_ID} .pm-toggle {
                position: relative;
                width: 45px;
                height: 26px;
                flex: 0 0 45px;
                appearance: none;
                -webkit-appearance: none;
                margin: 0;
                border: 0;
                border-radius: 20px;
                background: #8886;
                cursor: pointer;
            }

            #${PAGE_ID} .pm-toggle::before {
                content: "";
                position: absolute;
                top: 3px;
                left: 3px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: white;
                transition: transform .18s ease;
            }

            #${PAGE_ID} .pm-toggle:checked {
                background: #1684f8;
            }

            #${PAGE_ID} .pm-toggle:checked::before {
                transform: translateX(19px);
            }

            #${PAGE_ID} .pm-note {
                margin-top: 20px;
                font-size: 12px;
                line-height: 1.6;
                opacity: .65;
            }
        `;

        document.head.appendChild(style);
    }

    function ensurePage() {
        if (page?.isConnected) return page;

        addStyles();

        page = document.createElement("section");
        page.id = PAGE_ID;
        page.hidden = true;
        page.setAttribute("role", "dialog");
        page.setAttribute("aria-label", "Plugins");

        const header = document.createElement("header");
        header.className = "pm-head";

        const back = document.createElement("button");
        back.type = "button";
        back.className = "pm-back";
        back.textContent = "‹";
        back.setAttribute("aria-label", "Back");
        back.addEventListener("click", close);

        const title = document.createElement("h2");
        title.textContent = "Plugins";

        header.append(back, title);

        const content = document.createElement("main");
        content.className = "pm-content";

        const intro = document.createElement("p");
        intro.className = "pm-intro";
        intro.textContent = "Use connected tools with PingMe AI.";

        const cards = document.createElement("div");
        cards.className = "pm-cards";

        const note = document.createElement("p");
        note.className = "pm-note";
        note.textContent =
            "Switching a plugin on does not connect your account. " +
            "Connections and live integrations must be configured separately.";

        content.append(intro, cards, note);
        page.append(header, content);
        document.body.appendChild(page);

        return page;
    }

    function render() {
        if (!page?.isConnected) return;

        const host = page.querySelector(".pm-cards");
        host.replaceChildren();

        list().forEach(plugin => {
            const card = document.createElement("article");
            card.className = "pm-card";

            const icon = document.createElement("div");
            icon.className = "pm-icon";
            icon.textContent = plugin.icon || "◇";

            const info = document.createElement("div");
            info.className = "pm-info";

            const name = document.createElement("h3");
            name.textContent = plugin.name;

            const description = document.createElement("p");
            description.textContent = plugin.description;

            const status = document.createElement("div");
            status.className = "pm-status";
            status.textContent = plugin.connected
                ? "Connected"
                : plugin.enabled
                    ? "Enabled · Not connected"
                    : "Not connected";

            info.append(name, description, status);

            const toggle = document.createElement("input");
            toggle.type = "checkbox";
            toggle.className = "pm-toggle";
            toggle.checked = plugin.enabled;
            toggle.setAttribute("role", "switch");
            toggle.setAttribute("aria-label", "Enable " + plugin.name);
            toggle.addEventListener("change", () => {
                setEnabled(plugin.id, toggle.checked);
            });

            card.append(icon, info, toggle);
            host.appendChild(card);
        });
    }

    function open() {
        ensurePage();
        render();

        previousOverflow = document.body.style.overflow;
        page.hidden = false;
        document.body.style.overflow = "hidden";

        window.dispatchEvent(new CustomEvent("pingme:plugins-page-open"));
    }

    function close() {
        if (!page) return;

        page.hidden = true;
        document.body.style.overflow = previousOverflow;

        window.dispatchEvent(new CustomEvent("pingme:plugins-close"));
    }

    builtIns.forEach(register);

    window.PingMePlugins = {
        register,
        get,
        list,
        setEnabled,
        isEnabled,
        execute,
        open,
        close
    };

    window.addEventListener("pingme:plus-plugins", open);

    window.dispatchEvent(new CustomEvent("pingme:plugins-ready"));

    console.log("PingMe Plugins: Ready");
})();
