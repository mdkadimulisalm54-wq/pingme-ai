/* =========================================================
   PingMe AI — Think Harder
   ========================================================= */

(() => {
    "use strict";

    const KEY = "pingme_think_harder";

    function isEnabled() {
        return localStorage.getItem(KEY) === "true";
    }

    function setEnabled(enabled) {
        localStorage.setItem(KEY, String(Boolean(enabled)));

        window.dispatchEvent(
            new CustomEvent("pingme:think-harder", {
                detail: { enabled: Boolean(enabled) }
            })
        );
    }

    window.PingMeThinkHarder = {
        isEnabled,
        setEnabled,
        toggle() {
            setEnabled(!isEnabled());
            return isEnabled();
        }
    };

    console.log("PingMe Think Harder: Ready");
})();